{
  "name": "coursive-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Coursive resident assistant: embeds Pi via @earendil-works/pi-coding-agent SDK",
  "type": "module",
  "main": "src/host.mjs",
  "scripts": {
    "start": "node src/host.mjs",
    "validate:plugin": "node scripts/validate-plugin.mjs",
    "check": "node scripts/check-syntax.mjs",
    "test": "node --test 'src/**/*.test.mjs' 'scripts/**/*.test.mjs'"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "typebox": "1.3.27"
  }
}
