{
	"name": "coursive-plugin-review-lab",
	"version": "0.1.0",
	"private": true,
	"description": "Example v3 plugin: a review-card page, a course slot, a canvas tool, an agent tool and an approved write",
	"license": "MIT",
	"type": "module",
	"files": ["index.mjs", "README.md"],
	"coursive": {
		"id": "review-lab",
		"title": "复习卡实验室",
		"summary": "把课程要点做成复习卡，逐张翻看并存为笔记",
		"description": "Plugin Fabric 的示例插件：一个复习卡页面、课程页上的入口卡片、把复习卡钉到学习画布的工具、一个让助手生成卡片的工具，以及需要你批准才会执行的「存为笔记」。",
		"icon": "style",
		"categories": ["review"],
		"api": "^3.0.0",
		"runtime": [{ "kind": "pi", "entry": "index.mjs" }],
		"provides": [{ "service": "review.generate", "version": "1.0.0" }],
		"permissions": ["library.read", "library.write"],
		"examples": ["把这节课的要点做成复习卡"],
		"contributes": {
			"navigation": [{ "id": "deck", "title": "复习卡", "icon": "style", "page": "deck", "order": 50 }],
			"pages": [
				{
					"id": "deck",
					"title": "复习卡",
					"icon": "style",
					"renderer": "declarative",
					"document": {
						"schemaVersion": 1,
						"body": {
							"type": "column",
							"children": [
								{ "type": "text", "variant": "caption", "text": "${progress}" },
								{ "type": "card", "children": [
									{ "type": "text", "variant": "title", "text": "${front}" },
									{ "type": "text", "text": "${back}" }
								] },
								{
									"type": "row",
									"children": [
										{ "type": "button", "text": "开始", "action": "start" },
										{ "type": "button", "text": "显示答案", "action": "reveal", "variant": "tonal" },
										{ "type": "button", "text": "下一张", "action": "next", "args": { "step": 1 }, "variant": "tonal" },
										{ "type": "button", "text": "存为笔记", "action": "save", "variant": "text" }
									]
								}
							]
						}
					}
				}
			],
			"slots": [
				{
					"id": "course-review",
					"target": "course.detail.sections",
					"mode": "list",
					"order": 10,
					"document": {
						"schemaVersion": 1,
						"body": {
							"type": "card",
							"children": [
								{ "type": "text", "variant": "title", "text": "复习卡" },
								{ "type": "text", "text": "让助手把这门课的要点做成复习卡，再在这里逐张复习。" },
								{ "type": "button", "text": "打开复习卡", "action": "open", "variant": "tonal" }
							]
						}
					}
				},
				{
					"id": "canvas-pin",
					"target": "canvas.toolbar.tools",
					"mode": "list",
					"order": 10,
					"document": {
						"schemaVersion": 1,
						"body": {
							"type": "card",
							"children": [
								{ "type": "text", "variant": "title", "text": "复习卡" },
								{ "type": "text", "text": "把这组复习卡钉到画布中央，来源记为这节课；卸载插件后卡片仍保留。" },
								{
									"type": "row",
									"children": [
										{
											"type": "button",
											"text": "钉到画布",
											"action": "pin",
											"args": {
												"revision": { "ref": "context.canvas_revision" },
												"lecture_id": { "ref": "context.lecture_id" },
												"x": { "ref": "context.canvas_x" },
												"y": { "ref": "context.canvas_y" }
											}
										},
										{
											"type": "button",
											"text": "移除复习卡",
											"action": "unpin",
											"variant": "text",
											"args": { "revision": { "ref": "context.canvas_revision" }, "objects": { "ref": "context.canvas_objects" } }
										}
									]
								}
							]
						}
					}
				}
			],
			"actions": [
				{ "id": "start", "title": "开始", "action": "start" },
				{ "id": "reveal", "title": "显示答案", "action": "reveal" },
				{ "id": "next", "title": "下一张", "action": "next", "params": { "properties": { "step": "integer" } } },
				{ "id": "open", "title": "打开复习卡", "action": "open" },
				{
					"id": "pin",
					"title": "钉到画布",
					"action": "pin",
					"params": { "required": ["revision"], "properties": { "revision": "integer", "lecture_id": "string", "x": "number", "y": "number" } }
				},
				{
					"id": "unpin",
					"title": "移除复习卡",
					"action": "unpin",
					"params": { "required": ["revision"], "properties": { "revision": "integer", "objects": "array" } }
				},
				{ "id": "save", "title": "存为笔记", "action": "save", "permission": "library.write", "write": true }
			]
		}
	}
}
