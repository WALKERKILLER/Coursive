{
  "schema": "coursive/canvas-object@1",
  "base": {
    "id": "obj-1",
    "type": "review-lab.card",
    "schemaVersion": 1,
    "geometry": { "x": 40, "y": 60, "w": 320, "h": 240 },
    "content": { "title": "符号解释", "text": "先展开定义，再代入。", "data": { "steps": 3 } },
    "sourceAnchors": [{ "kind": "lecture", "lectureId": "lecture-1", "startMs": 12000, "endMs": 34000 }],
    "createdBy": { "pluginId": "review-lab", "pluginVersion": "1.0.0" },
    "revision": 1,
    "interactionPolicy": { "mode": "move" }
  },
  "cases": [
    { "name": "the base object" },
    { "name": "no anchors, text or data", "set": { "sourceAnchors": null, "content": { "title": "只有标题" } } },
    { "name": "rotated and fixed", "set": { "geometry.rotation": 3, "interactionPolicy": { "mode": "fixed" } } },
    { "name": "lecture from a point", "set": { "sourceAnchors": [{ "kind": "lecture", "lectureId": "lecture-1" }] } },
    { "name": "pdf page", "set": { "sourceAnchors": [{ "kind": "pdf", "file": "第 2 讲/讲义.pdf", "page": 3 }] } },
    { "name": "pdf range", "set": { "sourceAnchors": [{ "kind": "pdf", "file": "第 2 讲/讲义.pdf", "page": 3, "pageEnd": 5 }] } },
    { "name": "courseware file", "set": { "sourceAnchors": [{ "kind": "courseware", "file": "第 2 讲/课件.pptx" }] } },
    { "name": "transcript", "set": { "sourceAnchors": [{ "kind": "transcript", "lectureId": "lecture-1", "startMs": 12000, "endMs": 20000, "text": "所以这里用的是链式法则。" }] } },
    { "name": "handwriting", "set": { "sourceAnchors": [{ "kind": "stroke", "lectureId": "lecture-1", "strokeIds": ["stroke-1", "stroke-2"] }] } },
    { "name": "missing id", "set": { "id": null }, "code": "id-missing", "path": "id" },
    { "name": "id with a path", "set": { "id": "a/b" }, "code": "id-invalid", "path": "id" },
    { "name": "missing type", "set": { "type": "" }, "code": "type-missing", "path": "type" },
    { "name": "unqualified type", "set": { "type": "card" }, "code": "type-invalid", "path": "type" },
    { "name": "missing schema version", "set": { "schemaVersion": null }, "code": "schema-missing", "path": "schemaVersion" },
    { "name": "newer schema version", "set": { "schemaVersion": 2 }, "code": "schema-unsupported", "path": "schemaVersion" },
    { "name": "tiny width", "set": { "geometry.w": 4 }, "code": "geometry-invalid", "path": "geometry.w" },
    { "name": "missing height", "set": { "geometry.h": null }, "code": "geometry-invalid", "path": "geometry.h" },
    { "name": "unbounded x", "set": { "geometry.x": 2e9 }, "code": "geometry-invalid", "path": "geometry.x" },
    { "name": "rotation out of range", "set": { "geometry.rotation": 4 }, "code": "geometry-invalid", "path": "geometry.rotation" },
    { "name": "blank title", "set": { "content.title": " " }, "code": "content-invalid", "path": "content.title" },
    { "name": "missing plugin", "set": { "createdBy": {} }, "code": "origin-missing", "path": "createdBy.pluginId" },
    { "name": "invalid plugin id", "set": { "createdBy.pluginId": "Review Lab" }, "code": "origin-invalid", "path": "createdBy.pluginId" },
    { "name": "plugin version", "set": { "createdBy.pluginVersion": "1.0" }, "code": "origin-invalid", "path": "createdBy.pluginVersion" },
    { "name": "revision zero", "set": { "revision": 0 }, "code": "revision-invalid", "path": "revision" },
    { "name": "missing interaction mode", "set": { "interactionPolicy": {} }, "code": "interaction-missing", "path": "interactionPolicy.mode" },
    { "name": "unknown interaction mode", "set": { "interactionPolicy.mode": "drag" }, "code": "interaction-invalid", "path": "interactionPolicy.mode" },
    { "name": "stylus on a fixed object", "set": { "interactionPolicy": { "mode": "fixed", "stylusHitTest": true } }, "code": "interaction-invalid", "path": "interactionPolicy.stylusHitTest" },
    { "name": "unknown anchor kind", "set": { "sourceAnchors": [{ "kind": "slide" }] }, "code": "anchor-kind", "path": "sourceAnchors[0].kind" },
    { "name": "lecture without an id", "set": { "sourceAnchors": [{ "kind": "lecture", "startMs": 1, "endMs": 2 }] }, "code": "anchor-invalid", "path": "sourceAnchors[0].lectureId" },
    { "name": "inverted lecture interval", "set": { "sourceAnchors": [{ "kind": "lecture", "lectureId": "lecture-1", "startMs": 9000, "endMs": 1000 }] }, "code": "anchor-invalid", "path": "sourceAnchors[0].startMs" },
    { "name": "lecture interval past the bound", "set": { "sourceAnchors": [{ "kind": "lecture", "lectureId": "lecture-1", "endMs": 604800001 }] }, "code": "anchor-invalid", "path": "sourceAnchors[0].startMs" },
    { "name": "pdf page zero", "set": { "sourceAnchors": [{ "kind": "pdf", "file": "讲义.pdf" }] }, "code": "anchor-invalid", "path": "sourceAnchors[0].page" },
    { "name": "pdf range backwards", "set": { "sourceAnchors": [{ "kind": "pdf", "file": "讲义.pdf", "page": 5, "pageEnd": 3 }] }, "code": "anchor-invalid", "path": "sourceAnchors[0].pageEnd" },
    { "name": "pdf outside the course folder", "set": { "sourceAnchors": [{ "kind": "pdf", "file": "../讲义.pdf", "page": 1 }] }, "code": "anchor-invalid", "path": "sourceAnchors[0].file" },
    { "name": "courseware with a page", "set": { "sourceAnchors": [{ "kind": "courseware", "file": "课件.pptx", "page": 2 }] }, "code": "anchor-invalid", "path": "sourceAnchors[0].page" },
    { "name": "transcript without text", "set": { "sourceAnchors": [{ "kind": "transcript", "lectureId": "lecture-1", "startMs": 1000, "endMs": 2000 }] }, "code": "anchor-invalid", "path": "sourceAnchors[0].text" },
    { "name": "transcript of no length", "set": { "sourceAnchors": [{ "kind": "transcript", "lectureId": "lecture-1", "startMs": 2000, "endMs": 2000, "text": "嗯" }] }, "code": "anchor-invalid", "path": "sourceAnchors[0].startMs" },
    { "name": "handwriting without strokes", "set": { "sourceAnchors": [{ "kind": "stroke" }] }, "code": "anchor-invalid", "path": "sourceAnchors[0].strokeIds" },
    { "name": "handwriting stroke id", "set": { "sourceAnchors": [{ "kind": "stroke", "strokeIds": ["ok", "../x"] }] }, "code": "anchor-invalid", "path": "sourceAnchors[0].strokeIds[1]" },
    { "name": "anchor from another kind", "set": { "sourceAnchors": [{ "kind": "lecture", "lectureId": "lecture-1", "file": "讲义.pdf" }] }, "code": "anchor-invalid", "path": "sourceAnchors[0].file" }
  ]
}
